# =============================================================================
# RAG Chatbot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=<your_database_url_here>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
POSTGRES_DB=ragdb

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# Security Configuration
# =============================================================================
# Generate a secure random string (minimum 32 characters)
# Linux/Mac: openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# =============================================================================
# Application Configuration
# =============================================================================
# Directory for uploaded files (inside container)
UPLOAD_DIR=/app/uploads

# Vector database path (inside container)
VECTOR_DB_PATH=/app/data/chromadb

# File upload limits
MAX_FILE_SIZE_MB=10

# Debug mode
DEBUG=False

# =============================================================================
# RAG Engine Configuration (Optional - defaults provided)
# =============================================================================
# Gemini model to use
MODEL_NAME=gemini-1.5-pro

# LLM temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.1

# Number of document chunks to retrieve
TOP_K=5

# Maximum context tokens to send to LLM
MAX_CONTEXT_TOKENS=6000

# Maximum tokens in LLM response
MAX_RESPONSE_TOKENS=1000

# Minimum relevance score for retrieved chunks (0.0 to 1.0)
MIN_RELEVANCE_SCORE=0.7

# =============================================================================
# Frontend Configuration (when frontend is implemented)
# =============================================================================
# Backend API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8001

# Node environment
NODE_ENV=production
